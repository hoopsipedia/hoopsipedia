#!/bin/bash
# Pre-push hook: validate index.html has no JS syntax errors
# This prevents pushing broken code that crashes the entire site
# DO NOT BYPASS WITH --no-verify — if this fails, FIX THE CODE
#
# The same checks run in CI (.github/workflows/ci.yml). The JS check lives in
# scripts/validate_index_js.js so hook and CI can't drift apart.

# Load nvm if available (needed for node in non-interactive shells)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

echo "🔍 Running pre-push validation..."

node --max-old-space-size=8192 scripts/validate_index_js.js || exit 1

# Verify deploy-critical data files are valid JSON
for f in data.json h2h.json games_1.json games_2.json games_3.json; do
    node -e "JSON.parse(require('fs').readFileSync('$f','utf8')); console.log('✅ $f is valid JSON');" || { echo "❌ $f is invalid JSON"; exit 1; }
done

# Slice freshness: the site serves per-team/per-year slices (games/, boxscores/).
# If a source monolith was updated without re-running the split scripts, the site
# would silently serve stale data — block the push instead.
check_fresh() {
    if [ -f "$1" ] && [ -f "$2" ] && [ "$1" -nt "$2" ]; then
        echo "❌ $1 is newer than $2 — run python3 $3, then commit the slices"; exit 1
    fi
}
check_fresh games_1.json games/index.json scripts/split_games.py
check_fresh games_2.json games/index.json scripts/split_games.py
check_fresh games_3.json games/index.json scripts/split_games.py
check_fresh sr_boxscores.json boxscores/index.json scripts/split_boxscores.py
echo "✅ Data slices are fresh"

echo ""
echo "✅ All pre-push checks passed. Pushing..."
